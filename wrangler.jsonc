{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fantasy-mcp",
  "main": "cf/index.ts",
  "compatibility_date": "2026-09-12",
  "observability": { "enabled": true },
  "containers": [
    { "class_name": "FantasyContainer", "image": "./Dockerfile", "max_instances": 1, "instance_type": "basic" }
  ],
  "durable_objects": { "bindings": [{ "name": "FANTASY", "class_name": "FantasyContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FantasyContainer"] }],
  "routes": [{ "pattern": "fantasy.example.com", "custom_domain": true }]
}
