# Copy values to Render secrets, not a tracked .env file.
PILOT_BASE_URL=https://YOUR-PILOT.onrender.com
PILOT_AUTH0_ISSUER=https://YOUR-TENANT.us.auth0.com/
PILOT_AUTH0_API_CLIENT_ID=YOUR-CUSTOM-API-CLIENT-ID
PILOT_AUTH0_API_CLIENT_SECRET=SET-IN-RENDER-SECRETS
PILOT_YAHOO_CONNECTION=yahoo-pilot
# Exact Auth0 sub identifiers, not email addresses; at most two.
PILOT_ALLOWED_SUBJECTS=AUTH0-SUBJECT-ONE,AUTH0-SUBJECT-TWO
